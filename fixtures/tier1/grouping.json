{
  "schema": "tier1-grouping.v1",
  "description": "Golden cases for \u00a73.2 (normalising a print to a buy) and \u00a73.3 (grouping prints) of the Phase 1 spec. Shared by the Rust grouper (pm-core) and the Python research code.",
  "conventions": {
    "times": "Integer microseconds since the Unix epoch, UTC.",
    "decimals": "Strings; compare as decimal numbers, not as text.",
    "prints": "In arrival order. Feed each to the grouper at its recv_ts; after the last, close every open group.",
    "groups": "In the order they close: by closed_at, then seq. `prints` are indices into the case's prints; dropped duplicates appear in no group.",
    "seq": "Groups are numbered from 0 in the order they open.",
    "closed_at": "Receive time of the group's last join plus the window.",
    "vwap": "notional / shares, rounded half-even to 6 places."
  },
  "market": {
    "condition_id": "0xc1",
    "yes": "1111",
    "no": "1222"
  },
  "config": {
    "window_ms": 250,
    "dedup_retention_ms": 60000
  },
  "cases": [
    {
      "name": "single_buy",
      "note": "One print is one group, closed 250 ms of receive time after it arrived.",
      "prints": [
        {
          "token": "1111",
          "side": "BUY",
          "price": "0.20",
          "size": "100",
          "tx": "0xa1",
          "exchange_ts": 1790000000000000,
          "recv_ts": 1790000000050000
        }
      ],
      "expected": {
        "groups": [
          {
            "seq": 0,
            "prints": [
              0
            ],
            "outcome": "Yes",
            "bought_token": "1111",
            "tx_hashes": [
              "0xa1"
            ],
            "dup_cross_token": 0,
            "direction_conflict": 0,
            "flags": [],
            "shares": "100",
            "notional": "20",
            "vwap": "0.2",
            "closed_at": 1790000000300000
          }
        ],
        "late_cross_token_dups": 0
      }
    },
