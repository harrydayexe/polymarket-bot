set shell := ["bash", "-euo", "pipefail", "-c"]

# Build a debug binary
[default]
[group("build")]
[unix]
build:
    cargo build

# Build an optimised release binary
[group("build")]
[unix]
build-release:
    cargo build --release

# Type-check without producing a binary
[group("build")]
[unix]
check:
    cargo check --all-targets

# Delete build artifacts
[group("build")]
[unix]
clean:
    cargo clean

# Run the test suite, forwarding extra args to cargo test
[group("test")]
[unix]
test *args:
    cargo test {{ args }}

# Lint with clippy, treating warnings as errors
[group("lint")]
[unix]
lint:
    cargo clippy --all-targets -- -D warnings

# Format all code
[group("lint")]
[unix]
fmt:
    cargo fmt

# Check formatting without modifying files
[group("lint")]
[unix]
fmt-check:
    cargo fmt --check

# Run the archiver CLI, e.g. `just run check` or `just run gaps --help`
[group("run")]
[unix]
run *args:
    cargo run -- {{ args }}

# Run all CI checks: formatting, lints and tests
[group("ci")]
[unix]
ci: fmt-check lint test
